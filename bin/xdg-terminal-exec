#!/usr/bin/env bash
# Stand-in for xdg-terminal-exec. Ghostty is this machine's terminal.
# Omarchy passes --app-id=; Ghostty uses --class= (Wayland app_id).
dir=""
class=""
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dir)
            dir="${2:-}"
            shift 2
            ;;
        --app-id=*)
            class="${1#--app-id=}"
            shift
            ;;
        --app-id)
            class="${2:-}"
            shift 2
            ;;
        --class=*)
            class="${1#--class=}"
            shift
            ;;
        --print-id|--print-desktop)
            printf '%s\n' "com.mitchellh.ghostty.desktop"
            exit 0
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

cmd=(ghostty)
[[ -n "$dir" ]] && cmd+=(--working-directory="$dir")
[[ -n "$class" ]] && cmd+=(--class="$class")
exec "${cmd[@]}" "${args[@]}"
