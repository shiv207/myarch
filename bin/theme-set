#!/usr/bin/env python3
"""Apply a palette pack from ~/.config/omarchy/themes/<slug>/colors.toml.

Paints Hyprland, Kitty, Ghostty, Waybar, Rofi, btop, and GTK color-scheme.
Never touches Neovim, VS Code, or agent configs.
"""
from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
THEMES = HOME / ".config/omarchy/themes"
STATE = HOME / ".config/omarchy/current"
HYPR_THEME = HOME / ".config/hypr/theme.lua"
THEMED = HOME / ".config/omarchy/themed"

SKIP_TEMPLATES = {
    "neovim.lua.tpl",
    "vscode-theme.json.tpl",
    "claude.json.tpl",
}


def parse_toml_simple(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^([A-Za-z0-9_]+)\s*=\s*"(.*)"\s*$', line)
        if m:
            data[m.group(1)] = m.group(2)
            continue
        m = re.match(r'^([A-Za-z0-9_]+)\s*=\s*(true|false)\s*$', line)
        if m:
            data[m.group(1)] = m.group(2)
    return data


def hex_to_rgba(color: str, alpha: str = "ee") -> str:
    h = color.strip().lstrip("#")
    if len(h) == 6:
        return f"rgba({h}{alpha})"
    return color


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def render_templates(c: dict[str, str]) -> None:
    if not THEMED.is_dir():
        return
    for tpl in THEMED.glob("*.tpl"):
        if tpl.name in SKIP_TEMPLATES or tpl.name.endswith(".sample"):
            continue
        text = tpl.read_text(encoding="utf-8")

        def repl(match: re.Match[str]) -> str:
            key = match.group(1)
            if key.endswith("_strip"):
                return c.get(key[:-6], "").lstrip("#")
            return c.get(key, match.group(0))

        rendered = re.sub(r"\{\{\s*([A-Za-z0-9_]+)\s*\}\}", repl, text)
        dest_name = tpl.name.removesuffix(".tpl")
        dest = HOME / ".config" / "generated" / dest_name
        write(dest, rendered)


def apply(slug: str) -> None:
    theme_dir = THEMES / slug
    colors_path = theme_dir / "colors.toml"
    if not colors_path.is_file():
        sys.exit(f"No colors.toml in {theme_dir}")

    c = parse_toml_simple(colors_path)
    for key in (
        "background",
        "foreground",
        "accent",
        "selection",
        "muted",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "orange",
        "bright_foreground",
        "light_foreground",
        "dark_foreground",
        "lighter_background",
    ):
        c.setdefault(key, c.get("accent", "#888888"))

    accent = c["accent"]
    bg, fg, sel = c["background"], c["foreground"], c["selection"]
    mode = c.get("mode", "dark")

    write(
        HYPR_THEME,
        f"""-- Generated by theme-set from {slug}. Do not edit.
local active_border_color   = {{ colors = {{ "{hex_to_rgba(accent, "ee")}" }}, angle = 45 }}
local inactive_border_color = "rgba(595959aa)"

hl.config({{
    general = {{
        col = {{
            active_border   = active_border_color,
            inactive_border = inactive_border_color,
        }},
    }},
    group = {{
        col = {{
            border_active   = active_border_color,
            border_inactive = inactive_border_color,
        }},
    }},
}})
""",
    )

    kitty_palette = f"""foreground {fg}
background {bg}
selection_foreground {c["bright_foreground"]}
selection_background {sel}
cursor {c["bright_foreground"]}
cursor_text_color {bg}
active_border_color {accent}
color0 {bg}
color1 {c["red"]}
color2 {c["green"]}
color3 {c["yellow"]}
color4 {c["blue"]}
color5 {c["magenta"]}
color6 {c["cyan"]}
color7 {fg}
color8 {c["muted"]}
color9 {c.get("bright_red", c["red"])}
color10 {c.get("bright_green", c["green"])}
color11 {c.get("bright_yellow", c["yellow"])}
color12 {c.get("bright_blue", c["blue"])}
color13 {c.get("bright_magenta", c["magenta"])}
color14 {c.get("bright_cyan", c["cyan"])}
color15 {c["bright_foreground"]}
"""
    write(HOME / ".config/kitty/current-palette.conf", kitty_palette)
    # Keep the previous include name so existing kitty.conf still works.
    write(HOME / ".config/kitty/omarchy-current.conf", kitty_palette)

    ghostty_palette = f"""background = {bg}
foreground = {fg}
cursor-color = {c["bright_foreground"]}
selection-background = {sel}
selection-foreground = {c["bright_foreground"]}
palette = 0={bg}
palette = 1={c["red"]}
palette = 2={c["green"]}
palette = 3={c["yellow"]}
palette = 4={c["blue"]}
palette = 5={c["magenta"]}
palette = 6={c["cyan"]}
palette = 7={fg}
palette = 8={c["muted"]}
palette = 9={c.get("bright_red", c["red"])}
palette = 10={c.get("bright_green", c["green"])}
palette = 11={c.get("bright_yellow", c["yellow"])}
palette = 12={c.get("bright_blue", c["blue"])}
palette = 13={c.get("bright_magenta", c["magenta"])}
palette = 14={c.get("bright_cyan", c["cyan"])}
palette = 15={c["bright_foreground"]}
"""
    write(HOME / ".config/ghostty/themes/current", ghostty_palette)
    ghostty_conf = HOME / ".config/ghostty/config"
    if ghostty_conf.is_file():
        text = ghostty_conf.read_text(encoding="utf-8")
        if re.search(r"^theme\s*=", text, flags=re.M):
            text = re.sub(r"^theme\s*=.*$", "theme = current", text, count=1, flags=re.M)
        else:
            text = "theme = current\n" + text
        ghostty_conf.write_text(text, encoding="utf-8")

    write(
        HOME / ".config/colors/colors.css",
        f"""@define-color background {bg};
@define-color foreground {fg};
@define-color select {sel};

@define-color pink {accent};
@define-color purple {c["magenta"]};
@define-color red {c["red"]};
@define-color orange {c["orange"]};
@define-color yellow {c["yellow"]};
@define-color green {c["green"]};
@define-color blue {c["blue"]};
@define-color gray {c["muted"]};
""",
    )

    write(
        HOME / ".config/rofi/colors/colors.rasi",
        f"""* {{
    background: {bg};
    foreground: {fg};
    select: {sel};

    pink: {accent};
    purple: {c["magenta"]};
    red: {c["red"]};
    orange: {c["orange"]};
    yellow: {c["yellow"]};
    green: {c["green"]};
    blue: {c["blue"]};
    gray: {c["muted"]};

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @select;
}}
""",
    )
    colors_rasi = HOME / ".config/colors/colors.rasi"
    colors_rasi.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(HOME / ".config/rofi/colors/colors.rasi", colors_rasi)

    btop_theme = HOME / ".config/btop/themes/current.theme"
    write(
        btop_theme,
        f"""theme[main_bg]="{bg}"
theme[main_fg]="{fg}"
theme[title]="{fg}"
theme[hi_fg]="{accent}"
theme[selected_bg]="{sel}"
theme[selected_fg]="{accent}"
theme[inactive_fg]="{c["muted"]}"
theme[graph_text]="{c["light_foreground"]}"
theme[meter_bg]="{sel}"
theme[proc_misc]="{c["light_foreground"]}"
theme[cpu_box]="{c["magenta"]}"
theme[mem_box]="{c["green"]}"
theme[net_box]="{c["red"]}"
theme[proc_box]="{accent}"
theme[div_line]="{c["muted"]}"
theme[temp_start]="{c["green"]}"
theme[temp_mid]="{c["yellow"]}"
theme[temp_end]="{c["red"]}"
theme[cpu_start]="{c["cyan"]}"
theme[cpu_mid]="{c["blue"]}"
theme[cpu_end]="{c["magenta"]}"
theme[free_start]="{c["magenta"]}"
theme[free_mid]="{c["blue"]}"
theme[free_end]="{c["cyan"]}"
theme[cached_start]="{c["blue"]}"
theme[cached_mid]="{c["cyan"]}"
theme[cached_end]="{c["magenta"]}"
theme[available_start]="{c["yellow"]}"
theme[available_mid]="{c["red"]}"
theme[available_end]="{c["red"]}"
theme[used_start]="{c["green"]}"
theme[used_mid]="{c["cyan"]}"
theme[used_end]="{c["blue"]}"
theme[download_start]="{c["yellow"]}"
theme[download_mid]="{c["red"]}"
theme[download_end]="{c["red"]}"
theme[upload_start]="{c["green"]}"
theme[upload_mid]="{c["cyan"]}"
theme[upload_end]="{c["blue"]}"
theme[process_start]="{c["cyan"]}"
theme[process_mid]="{c["blue"]}"
theme[process_end]="{c["magenta"]}"
theme[gradient_color_0]="{bg}"
theme[gradient_color_1]="{c["lighter_background"]}"
theme[gradient_color_2]="{sel}"
theme[gradient_color_3]="{c["muted"]}"
theme[gradient_color_4]="{c["dark_foreground"]}"
theme[gradient_color_5]="{fg}"
theme[gradient_color_6]="{c["light_foreground"]}"
theme[gradient_color_7]="{c["bright_foreground"]}"
""",
    )
    btop_conf = HOME / ".config/btop/btop.conf"
    if btop_conf.is_file():
        text = btop_conf.read_text(encoding="utf-8")
        text = re.sub(
            r"^color_theme\s*=\s*.*$",
            f'color_theme = "{btop_theme}"',
            text,
            count=1,
            flags=re.M,
        )
        btop_conf.write_text(text, encoding="utf-8")

    scheme = "prefer-light" if mode == "light" else "prefer-dark"
    gtk_theme = "adw-gtk3" if mode == "light" else "adw-gtk3-dark"
    subprocess.run(
        ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme],
        check=False,
    )
    subprocess.run(
        ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme],
        check=False,
    )

    icons_file = theme_dir / "icons.theme"
    if icons_file.is_file():
        icon_name = icons_file.read_text(encoding="utf-8").strip().splitlines()[0].strip()
        icon_dir = Path("/usr/share/icons") / icon_name
        if icon_dir.is_dir():
            subprocess.run(
                ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon_name],
                check=False,
            )

    render_templates(c)

    extra_bgs = HOME / ".config/omarchy/backgrounds" / slug
    bgs = sorted(
        p
        for folder in (theme_dir / "backgrounds", extra_bgs)
        if folder.is_dir()
        for p in folder.glob("*")
        if p.is_file() and p.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}
    )
    if bgs and shutil.which("awww"):
        subprocess.run(
            ["awww", "img", str(bgs[0]), "--transition-type", "any", "--transition-duration", "2"],
            check=False,
        )

    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(slug + "\n", encoding="utf-8")

    hook = HOME / ".config/omarchy/hooks/run-event"
    if hook.is_file():
        subprocess.run([str(hook), "theme-set", slug], check=False)

    subprocess.run(["hyprctl", "reload"], check=False)
    subprocess.run(["killall", "-SIGUSR2", "waybar"], check=False)

    print(f"Applied theme: {slug} (nvim/agents untouched)")


def list_themes() -> list[str]:
    if not THEMES.is_dir():
        return []
    return sorted(p.name for p in THEMES.iterdir() if (p / "colors.toml").is_file())


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print("Usage: theme-set <slug|list>")
        print("Themes in", THEMES)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd == "list":
        for name in list_themes():
            print(name)
        return
    slugs = list_themes()
    wanted = cmd.lower().replace(" ", "-")
    if wanted not in slugs:
        sys.exit(f"Unknown theme {cmd!r}. Try: theme-set list")
    apply(wanted)


if __name__ == "__main__":
    main()
